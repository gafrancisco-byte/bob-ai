Set-Content .gitignore @"
# Dependencies
node_modules/
.pnp
.pnp.js

# Bun
bun.lockb

# Build output
dist/
dist-ssr/

# Local env files
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# TypeScript cache
*.tsbuildinfo

# Vite cache
.vite/
"@